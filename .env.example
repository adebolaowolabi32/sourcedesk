# Copy to .env. Never commit a real API key.
ANSWER_MODE=rag
OPENAI_API_KEY=
# Optional path to a separately confirmed, git-ignored env file containing the key.
# OPENAI_ENV_FILE=apikey
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DATABASE_URL=postgresql://sourcedesk:sourcedesk_local@127.0.0.1:55433/sourcedesk
# Browser sessions and review cases remain in SQLite.
DB_PATH=data/sourcedesk.db
PORT=3010
