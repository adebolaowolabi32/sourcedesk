{
  "name": "sourcedesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "evaluate": "tsx evals/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "index:knowledge": "tsx server/index-knowledge.ts",
    "evaluate:live": "tsx evals/live.ts",
    "build:portfolio": "tsc --noEmit && vite build --mode portfolio",
    "preview:portfolio": "vite preview --mode portfolio --host 127.0.0.1 --port 4173",
    "test:portfolio": "playwright test --config playwright.portfolio.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  }
}
